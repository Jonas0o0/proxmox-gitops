# URL de l'API Proxmox
proxmox_endpoint  = "https://{{ PROXMOX_HOST_IP }}:8006/api2/json"

# Utilisateur Proxmox pour Terraform (ex: terraform)
# Domaine de l'utilisateur (ex: pve ou pam)
# Identifiant du Token (ex: provision)
# Secret du Token (généré une seule fois par Proxmox)
proxmox_api_token = "{{ PROXMOX_USER }}@{{ PROXMOX_REALM }}!{{ PROXMOX_TOKEN_ID }}={{ PROXMOX_TOKEN_SECRET }}"

# Ignorer les erreurs TLS (true pour certificats auto-signés)
proxmox_insecure = true

proxmox_ssh_username         = "{{ PROXMOX_SSH_USER }}"

# Nom du fichier de votre clé SSH (ex: proxmox_terraform)
proxmox_ssh_private_key_path = "~/.ssh/{{ PROXMOX_SSH_KEY_NAME }}"
ssh_public_key_path          = "~/.ssh/{{ PROXMOX_SSH_KEY_NAME }}.pub"

storage        = "{{ PROXMOX_STORAGE }}"

# Stockage pour les sauvegardes et templates (ex: local)
backup_storage = "{{ BACKUP_STORAGE }}"

node_name      = "{{ PROXMOX_NODE }}"

# Adresse IP locale du serveur Proxmox (ex: 192.168.1.100)
proxmox_host_ip    = "{{ PROXMOX_HOST_IP }}"

# Sous-réseau LAN de votre domicile (ex: 192.168.1.0/24)
proxmox_lan_subnet = "{{ PROXMOX_LAN_SUBNET }}"
